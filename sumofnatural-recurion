import java.util.*;
public class sumofnatural {
    public static int son(int n){
        if(n==0){
            return 0;
        }
        return n + son(n-1);

    }
    public static void main(String[] args){
        Scanner c = new Scanner(System.in);
        int n = c.nextInt();
        System.out.println(son(n)); 
        c.close();
    }
}
